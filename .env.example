# Copy this file to .env and fill in your Bonsai credentials.
# Do not commit the real .env file.

# Cluster URL without username/password, e.g.
# https://assertive-idesia-5-xxxxx.region.bonsaisearch.net:443
BONSAI_URL=https://YOUR-CLUSTER.region.bonsaisearch.net:443

BONSAI_USER=your-bonsai-username
BONSAI_PASS=your-bonsai-password

# Optional: override the default index name
# BONSAI_INDEX=mbti-docs
